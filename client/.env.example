# Clerk publishable key (client-side; safe to expose). Get it from the Clerk dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Backend base URL. Leave blank in dev (Vite proxies /api to 127.0.0.1:4000);
# set to the Render URL in production, e.g. https://your-app.onrender.com
VITE_API_BASE=
