# Server environment (NFR-04: secrets only in env vars). Copy to `.env` and fill.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (free M0 tier).
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fyp?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/fyp

# Clerk (Google login). From the Clerk dashboard -> API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Comma-separated allowed client origins (CORS). The deployed Vercel URL goes here too.
CLIENT_ORIGIN=http://localhost:5173

# §5.1 grading thresholds (reported in the report).
GRADING_FAST_MS=4000
GRADING_SLOW_MS=12000

# §5.6 default session size.
SESSION_SIZE=10
