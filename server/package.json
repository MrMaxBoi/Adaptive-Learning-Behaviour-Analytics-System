{
  "name": "@fyp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "start": "node dist/server/src/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "seed": "node --experimental-strip-types src/db/seed.ts"
  },
  "dependencies": {
    "@clerk/express": "^1.3.4",
    "@fyp/shared": "*",
    "express": "^4.21.2",
    "mongoose": "^8.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
